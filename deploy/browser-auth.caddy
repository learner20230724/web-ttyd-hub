(browser_login) {
	handle {args[1]}/* {
		uri strip_prefix {args[1]}
		reverse_proxy 127.0.0.1:4281 {
			header_up X-Login-Scope {args[0]}
			header_up X-Login-Client {remote_host}
		}
	}
}

(browser_authorize) {
	request_header -X-Browser-Upstream
	forward_auth 127.0.0.1:4281 {
		uri /verify
		header_up X-Login-Scope {args[0]}
		copy_headers X-Browser-Upstream
	}
}

(browser_legacy_redirect) {
	@browser_document {
		method GET HEAD
		header Accept *text/html*
		not header User-Agent *TTYdHub*
		not query legacy=1
		not path /downloads/*
	}
	redir @browser_document {args[0]}{uri} 307
}
