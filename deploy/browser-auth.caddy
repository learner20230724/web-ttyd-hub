(browser_login) {
	handle {args[1]}/* {
		uri strip_prefix {args[1]}
		reverse_proxy 127.0.0.1:4281 {
			header_up X-Login-Scope {args[0]}
			header_up X-Login-Client {remote_host}
		}
	}
}

(browser_authorize) {
	request_header -X-Browser-Upstream
	reverse_proxy 127.0.0.1:4281 {
		method GET
		rewrite /verify
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		header_up X-Login-Scope {args[0]}
		@verified status 204
		handle_response @verified {
			copy_response_headers {
				include Set-Cookie
			}
			request_header X-Browser-Upstream {rp.header.X-Browser-Upstream}
		}
	}
}

(browser_legacy_redirect) {
	@browser_document {
		method GET HEAD
		header Accept *text/html*
		not header User-Agent *TTYdHub*
		not query legacy=1
		not path /downloads/*
	}
	redir @browser_document {args[0]}{uri} 307
}
