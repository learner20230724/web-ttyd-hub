{
  "name": "web-ttyd-hub",
  "version": "1.0.0",
  "description": "Web terminal session manager based on ttyd and tmux",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "node server/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node server/index.js",
    "test": "node scripts/test.js",
    "test:terminal": "node tests/terminal-browser.cjs",
    "deploy:web": "python3 scripts/deploy-web.py"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5",
    "node-pty": "1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "1.63.0"
  }
}
